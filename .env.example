# Nginx Configuration
NGINX_PORT=80

# PostgreSQL
POSTGRES_PORT=8005
POSTGRES_DB=sales_support_ai_copilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# MinIO
MINIO_API_PORT=8006
MINIO_CONSOLE_PORT=8007
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123456

# Qdrant
QDRANT_HTTP_PORT=8008
QDRANT_GRPC_PORT=8009

MODEL_PATH=model/lead_scoring.pkl
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# AI Copilot Gemini API Key
GEMINI_API_KEY="your_gemini_api_key_here"
QDRANT_URL=http://localhost:8008

# --- App Backend --- 
PORT=3001
CORS_ORIGIN=http://localhost:3000,http://localhost

# --- Auth ---
JWT_ACCESS_SECRET="your_jwt_access_secret_key_here"
JWT_ACCESS_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_SECONDS=2592000
VERIFY_EMAIL_TOKEN_EXPIRES_IN_SECONDS=86400

# --- Database Connection ---
DATABASE_URL=postgresql://postgres:postgres@localhost:8005/sales_support_ai_copilot?schema=public

# --- MinIO Service Configuration ---
MINIO_ENDPOINT=localhost
MINIO_PORT=8006
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123456
MINIO_BUCKET=sales-support-ai-copilot

# --- SMTP Mail Server ---
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=false
MAIL_SMTP_FROM="your_email@gmail.com"
MAIL_SMTP_USER="your_email@gmail.com"
MAIL_SMTP_PASSWORD="your_smtp_app_password_here"

# --- Frontend API Endpoint ---
# Set to relative path '/api/v1' when proxying through Nginx
NEXT_PUBLIC_API_URL=/api/v1
